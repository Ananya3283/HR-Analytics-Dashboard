table 'Metric Selector'

	column Metric
		dataType: string
		isDataTypeInferred
		isNameInferred
		summarizeBy: none
		sourceColumn: [Metric]
		sortByColumn: 'Metric Order'

	column 'Metric Order'
		dataType: int64
		formatString: 0
		isHidden
		isDataTypeInferred
		isNameInferred
		summarizeBy: none
		sourceColumn: [Metric Order]

	partition 'Metric Selector' = calculated
		mode: import
		source =
			DATATABLE (
			    "Metric", STRING, "Metric Order", INTEGER,
			    { { "Attrition Rate", 1 }, { "Leavers", 2 }, { "Headcount", 3 } }
			)
