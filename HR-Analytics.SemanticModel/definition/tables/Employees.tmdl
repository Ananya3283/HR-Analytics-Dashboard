table Employees

	column EmployeeNumber
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: EmployeeNumber

	column Age
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: Age

	column Attrition
		dataType: string
		summarizeBy: none
		sourceColumn: Attrition

	column 'Attrition Flag'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: sum
		sourceColumn: Attrition Flag

	column BusinessTravel
		dataType: string
		summarizeBy: none
		sourceColumn: BusinessTravel

	column Department
		dataType: string
		summarizeBy: none
		sourceColumn: Department

	column DistanceFromHome
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: DistanceFromHome

	column Education
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Education

	column 'Education Level'
		dataType: string
		summarizeBy: none
		sourceColumn: Education Level
		sortByColumn: Education

	column EducationField
		dataType: string
		summarizeBy: none
		sourceColumn: EducationField

	column EnvironmentSatisfaction
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: EnvironmentSatisfaction

	column 'Environment Satisfaction'
		dataType: string
		summarizeBy: none
		sourceColumn: Environment Satisfaction
		sortByColumn: EnvironmentSatisfaction

	column Gender
		dataType: string
		summarizeBy: none
		sourceColumn: Gender

	column JobInvolvement
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: JobInvolvement

	column JobLevel
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: JobLevel

	column 'Job Level'
		dataType: string
		summarizeBy: none
		sourceColumn: Job Level
		sortByColumn: JobLevel

	column JobRole
		dataType: string
		summarizeBy: none
		sourceColumn: JobRole

	column JobSatisfaction
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: JobSatisfaction

	column 'Job Satisfaction'
		dataType: string
		summarizeBy: none
		sourceColumn: Job Satisfaction
		sortByColumn: JobSatisfaction

	column MaritalStatus
		dataType: string
		summarizeBy: none
		sourceColumn: MaritalStatus

	column MonthlyIncome
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: MonthlyIncome

	column NumCompaniesWorked
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: NumCompaniesWorked

	column OverTime
		dataType: string
		summarizeBy: none
		sourceColumn: OverTime

	column PercentSalaryHike
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: PercentSalaryHike

	column PerformanceRating
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: PerformanceRating

	column RelationshipSatisfaction
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: RelationshipSatisfaction

	column StockOptionLevel
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: StockOptionLevel

	column 'Stock Options'
		dataType: string
		summarizeBy: none
		sourceColumn: Stock Options
		sortByColumn: StockOptionLevel

	column TotalWorkingYears
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: TotalWorkingYears

	column TrainingTimesLastYear
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: TrainingTimesLastYear

	column WorkLifeBalance
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: WorkLifeBalance

	column 'Work-Life Balance'
		dataType: string
		summarizeBy: none
		sourceColumn: Work-Life Balance
		sortByColumn: WorkLifeBalance

	column YearsAtCompany
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: YearsAtCompany

	column YearsInCurrentRole
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: YearsInCurrentRole

	column YearsSinceLastPromotion
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: YearsSinceLastPromotion

	column YearsWithCurrManager
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: YearsWithCurrManager

	column 'Age Band'
		dataType: string
		summarizeBy: none
		sourceColumn: Age Band
		sortByColumn: 'Age Band Order'

	column 'Age Band Order'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Age Band Order

	column 'Tenure Band'
		dataType: string
		summarizeBy: none
		sourceColumn: Tenure Band
		sortByColumn: 'Tenure Band Order'

	column 'Tenure Band Order'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Tenure Band Order

	column 'Income Band'
		dataType: string
		summarizeBy: none
		sourceColumn: Income Band
		sortByColumn: 'Income Band Order'

	column 'Income Band Order'
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: Income Band Order

	partition Employees = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "HR.csv"), [Delimiter = ",", Columns = 35, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
			    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    // EmployeeCount, Over18 and StandardHours hold one value for every row; the three *Rate columns are undocumented
			    Dropped = Table.RemoveColumns(Promoted, {"EmployeeCount", "Over18", "StandardHours", "DailyRate", "HourlyRate", "MonthlyRate"}),
			    TextCols = {"Attrition", "BusinessTravel", "Department", "EducationField", "Gender", "JobRole", "MaritalStatus", "OverTime"},
			    Typed = Table.TransformColumnTypes(Dropped,
			        List.Transform(Table.ColumnNames(Dropped), each {_, if List.Contains(TextCols, _) then type text else Int64.Type})),
			    CleanTravel = Table.ReplaceValue(Typed, "_", " ", Replacer.ReplaceText, {"BusinessTravel"}),
			    Flag = Table.AddColumn(CleanTravel, "Attrition Flag", each if [Attrition] = "Yes" then 1 else 0, Int64.Type),
			    // Code-to-label lookups from the IBM data dictionary
			    EduLabel = Table.AddColumn(Flag, "Education Level", each {"Below College", "College", "Bachelor", "Master", "Doctor"}{[Education] - 1}, type text),
			    EnvLabel = Table.AddColumn(EduLabel, "Environment Satisfaction", each {"Low", "Medium", "High", "Very High"}{[EnvironmentSatisfaction] - 1}, type text),
			    JobSatLabel = Table.AddColumn(EnvLabel, "Job Satisfaction", each {"Low", "Medium", "High", "Very High"}{[JobSatisfaction] - 1}, type text),
			    WlbLabel = Table.AddColumn(JobSatLabel, "Work-Life Balance", each {"Bad", "Good", "Better", "Best"}{[WorkLifeBalance] - 1}, type text),
			    LevelLabel = Table.AddColumn(WlbLabel, "Job Level", each "Level " & Text.From([JobLevel]), type text),
			    StockLabel = Table.AddColumn(LevelLabel, "Stock Options", each "Level " & Text.From([StockOptionLevel]), type text),
			    // Bands: each label gets an order column so visuals sort 18-25, 26-35 ... instead of alphabetically
			    AgeOrder = Table.AddColumn(StockLabel, "Age Band Order", each if [Age] <= 25 then 1 else if [Age] <= 35 then 2 else if [Age] <= 45 then 3 else if [Age] <= 55 then 4 else 5, Int64.Type),
			    AgeBand = Table.AddColumn(AgeOrder, "Age Band", each {"18-25", "26-35", "36-45", "46-55", "56+"}{[Age Band Order] - 1}, type text),
			    TenureOrder = Table.AddColumn(AgeBand, "Tenure Band Order", each if [YearsAtCompany] <= 2 then 1 else if [YearsAtCompany] <= 5 then 2 else if [YearsAtCompany] <= 10 then 3 else 4, Int64.Type),
			    TenureBand = Table.AddColumn(TenureOrder, "Tenure Band", each {"0-2 yrs", "3-5 yrs", "6-10 yrs", "10+ yrs"}{[Tenure Band Order] - 1}, type text),
			    IncomeOrder = Table.AddColumn(TenureBand, "Income Band Order", each if [MonthlyIncome] < 3000 then 1 else if [MonthlyIncome] < 5000 then 2 else if [MonthlyIncome] < 10000 then 3 else 4, Int64.Type),
			    IncomeBand = Table.AddColumn(IncomeOrder, "Income Band", each {"Under 3K", "3K-5K", "5K-10K", "10K+"}{[Income Band Order] - 1}, type text)
			in
			    IncomeBand
