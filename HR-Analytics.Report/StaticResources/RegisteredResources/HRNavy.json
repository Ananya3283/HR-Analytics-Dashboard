{
  "name": "HR Navy",
  "dataColors": [
    "#3D63C9",
    "#B26B00",
    "#C8325B",
    "#00829B",
    "#9AA8B3",
    "#46535D",
    "#7A5CC2",
    "#D9A21B"
  ],
  "background": "#FFFFFF",
  "foreground": "#172026",
  "tableAccent": "#172026",
  "good": "#2E9E6A",
  "neutral": "#D9A21B",
  "bad": "#C23B5A",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#172026"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 9,
      "color": "#5D6B75"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 22,
      "color": "#172026"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DCDED8"
              }
            },
            "radius": 8
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 6,
            "bottom": 6,
            "left": 10,
            "right": 10
          }
        ],
        "title": [
          {
            "show": true,
            "fontSize": 11,
            "fontColor": {
              "solid": {
                "color": "#172026"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7F7F4"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
