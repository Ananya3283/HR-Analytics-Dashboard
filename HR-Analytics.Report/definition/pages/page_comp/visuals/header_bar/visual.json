                    "value": "HR Analytics",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "20pt",
                      "color": "#FFFFFF"
                    }
                  },
                  {
                    "value": "   Pay, pay equity and the cost of attrition",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#AEB8BF"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    "visualContainerObjects": {
      "background": [
